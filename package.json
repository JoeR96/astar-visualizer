{
  "name": "astar-visualizer",
  "private": false,
  "version": "1.0.8",
  "type": "module",
  "description": "A React component for visualizing A* pathfinding algorithm",
  "main": "./dist/astar-visualizer.umd.cjs",
  "module": "./dist/astar-visualizer.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/astar-visualizer.js",
      "require": "./dist/astar-visualizer.umd.cjs",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "astar",
    "pathfinding",
    "visualizer",
    "react",
    "algorithm",
    "visualization"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "tsc --project tsconfig.lib.json && vite build --config vite.config.lib.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write .",
    "test": "vitest",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "framer-motion": "^10.16.4",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "husky": "^8.0.3",
    "lint-staged": "^14.0.1",
    "storybook": "^7.4.2",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "vitest": "^3.0.4"
  }
}
